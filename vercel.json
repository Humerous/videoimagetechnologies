{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "videoimagetechnologies.co.za"
        }
      ],
      "destination": "https://www.videoimagetechnologies.co.za/:path*",
      "permanent": true
    },
