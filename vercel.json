{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "videoimagetechnologies.vercel.app" }
      ],
      "destination": "https://www.videoimagetechnologies.co.za/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "videoimagetechnologies-chameleonunicodestudios.vercel.app" }
      ],
      "destination": "https://www.videoimagetechnologies.co.za/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "videoimagetechnologies-git-main-chameleonunicodestudios.vercel.app" }
      ],
      "destination": "https://www.videoimagetechnologies.co.za/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "videoimagetechnologies.com" }
      ],
      "destination": "https://www.videoimagetechnologies.co.za/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.videoimagetechnologies.com" }
      ],
      "destination": "https://www.videoimagetechnologies.co.za/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.videoimagetechnologies.co.za/>; rel=\"canonical\""
        }
      ]
    }
  ]
}
